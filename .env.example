# GoMeat - Environment Configuration
PORT=5000
JWT_SECRET=gomeat-cuts-india-secret-2026

# MongoDB Connection String (Atlas or Local)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sagarfresh?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sagarfresh

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Backend Client ID for cryptographic token verification (google-auth-library)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Vite Client ID for Google Identity Services (@react-oauth/google)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional Frontend URL for strict CORS / Redirects
FRONTEND_URL=https://your-domain.vercel.app

# Meta WhatsApp Cloud API (For Direct AI WhatsApp Commerce)
# 1. Webhook URL: https://<your-domain>.vercel.app/api/webhook/whatsapp
# 2. Verify Token: gomeat_whatsapp_verify_2026
WHATSAPP_TOKEN=your_meta_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=gomeat_whatsapp_verify_2026
