{
  "name": "gomeat-monorepo",
  "version": "1.0.0",
  "description": "GoMeat - Fresh Quality. Delivered with Care. Full-Stack D2C Fresh Meat & Coastal Seafood Platform with Reusable Cold-Box Logistics",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cd backend && npm start",
    "dev": "node scripts/start-dev.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "node scripts/test-workflows.js",
    "lint": "cd frontend && npm run lint",
    "user-app:start": "npm --prefix apps/user-app run start",
    "user-app:web": "npm --prefix apps/user-app run web",
    "delivery-app:start": "npm --prefix apps/delivery-app run start",
    "delivery-app:web": "npm --prefix apps/delivery-app run web",
    "partner-app:start": "npm --prefix apps/partner-app run start",
    "partner-app:web": "npm --prefix apps/partner-app run web"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.4",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.16.0",
    "razorpay": "^2.9.8",
    "uuid": "^11.1.0"
  }
}
