# ==========================================
# GoMeat Monorepo - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Production build outputs
dist/
build/
frontend/dist/
backend/dist/
apps/*/dist/
.expo/
apps/*/.expo/

# Local Environment Variables
.env
.env.local
.env.*.local
.env.development
.env.production
backend/.env
frontend/.env

# Logs and Process PIDs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.system_generated/
*.pid
*.seed
*.pid.lock

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Temporary Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.swp
*.swo

# Vercel Deployment Cache
.vercel/

# Temporary artifacts & binary decks
~$*
docs/presentations/*.pdf
docs/presentations/*.pptx
screenshots/
